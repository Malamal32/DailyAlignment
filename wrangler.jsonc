{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dailyalignment",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dailyalignment",
      // Paste the id from Storage & databases → D1
      "database_id": "415dd814-71d7-46b4-8272-3cc8e1f45455"
    }
  ],
  // Sign-in is handled by Cloudflare Access (Zero Trust).
  "vars": {
    // Your Zero Trust team domain, e.g. "yourteam.cloudflareaccess.com"
    "TEAM_DOMAIN": "shrill-wood-d821.cloudflareaccess.com",
    // The Application Audience (AUD) tag of this app's Access application
    "POLICY_AUD": "26d8b24a-9ab5-4518-8d42-64828443847a"
  }
}
