{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-alignment",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dailyalignment",
      // Paste the id from Storage & databases → D1
      "database_id": "PASTE-YOUR-DATABASE-ID-HERE"
    }
  ],
  // Sign-in is handled by Cloudflare Access (Zero Trust).
  "vars": {
    // Your Zero Trust team domain, e.g. "yourteam.cloudflareaccess.com"
    "TEAM_DOMAIN": "",
    // The Application Audience (AUD) tag of this app's Access application
    "POLICY_AUD": ""
  }
}
