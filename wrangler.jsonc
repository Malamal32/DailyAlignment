{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-alignment",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dailyalignment",
      // Paste the id from Storage & databases → D1 (or: npx wrangler d1 create dailyalignment)
      "database_id": "PASTE-YOUR-DATABASE-ID-HERE"
    }
  ],
  // Cloudflare Email Service sends the sign-in codes
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "APP_NAME": "DailyAlignment",
    // Must be an address on a domain you've set up for email in Cloudflare
    "MAIL_FROM": "login@yourdomain.com"
  }
}
